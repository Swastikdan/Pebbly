{
  "name": "pebbly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:web": "vite dev --port 3000",
    "dev:cf": "pnpm build && wrangler dev",
    "preview:cf": "pnpm build && wrangler dev",
    "build": "vite build",
    "start": "vite preview --port 5296",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pebbly --local",
    "db:migrate:prod": "wrangler d1 migrations apply pebbly --remote",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts",
    "deploy:cf": "pnpm build && wrangler deploy",
    "lint": "biome lint --max-diagnostics 20",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx}": [
      "biome check --fix --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-fetch/fetch": "^1.3.1",
    "@clerk/backend": "^3.16.10",
    "@clerk/react": "^6.14.5",
    "@clerk/ui": "^1.30.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@openrouter/sdk": "^1.2.67",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.1",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/router-plugin": "^1.168.35",
    "@unpic/react": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "h3": "2.0.1-rc.26",
    "h3-rules": "0.1.0",
    "lucide-react": "^0.544.0",
    "nitro": "npm:nitro-nightly@latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tanstack/react-devtools": "^0.7.11",
    "@tanstack/react-query-devtools": "^5.102.1",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "seroval": "^1.6.2",
    "shadcn": "^4.19.0",
    "terser": "^5.50.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
