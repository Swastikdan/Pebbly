{
  "name": "pebbly",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,convex -c blue,magenta \"vite dev --port 5296 --host\" \"pnpm dlx convex dev\"",
    "dev:web": "vite dev --port 3000",
    "build": "vite build",
    "build:vercel": "pnpm dlx convex deploy --cmd 'pnpm run build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "start": "vite preview --port 5296",
    "lint": "biome lint --max-diagnostics 20",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "pnpm dlx convex typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "biome check --fix --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/themes": "^2.4.57",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^1.52.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-plugin": "^1.168.23",
    "@unpic/react": "^1.0.2",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "lucide-react": "^0.544.0",
    "nitro": "npm:nitro-nightly@latest",
    "postcss": "^8.5.23",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.4.2",
    "vite-tsconfig-paths": "^5.1.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@tanstack/react-devtools": "^0.7.11",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.11.3",
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.2.0",
    "terser": "^5.49.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "web-vitals": "^5.3.0"
  }
