# Clerk Auth
VITE_CLERK_ISSUER_URL=https://your-app.clerk.accounts.dev
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# TMDB API (read-only public API key - safe for client)
VITE_PUBLIC_TMDB_ACCESS_TOKEN=your_tmdb_read_access_token
VITE_PUBLIC_TMDB_API_URL=https://api.themoviedb.org/3

# Embeddable video player base URL. The provider must allow being framed
# (no `frame-ancestors 'none'` / `X-Frame-Options: DENY`). Its URL scheme
# must be `/movie/{tmdbId}` and `/tv/{tmdbId}/{season}/{episode}` and it
# should postMessage PLAYER_EVENT payloads (see src/lib/watch-progress.ts).


# AI (server-only - never expose in client code)
# Production uses the Cloudflare Workers AI binding configured in wrangler.toml.
# Gemini is optional and used as the local-development fallback.
GEMINI_API_KEY=your_gemini_key

# Local dev secrets live in .dev.vars (gitignored); production uses
# `wrangler secret put <NAME>` with the same names.

# Clerk (server-side session token verification via @clerk/backend)
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_ISSUER_URL=https://your-app.clerk.accounts.dev

# Cloudflare (needed for `pnpm db:studio` remote dashboard + GitHub Actions)
CLOUDFLARE_API_TOKEN=your-api-token-with-d1-edit
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Sentry source-map upload (build-time only; not needed for local dev).
# Create at https://sentry.io/settings/auth-tokens/ with `org:read` +
# `project:releases` scopes. Simply leave unset to skip Sentry uploads.
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Dev-only RPC tracing: prints incoming args + outgoing response bodies to the
# dev-server console for every server-function call. Ignored in production
# builds (hard NODE_ENV gate). Uncomment locally or add to .dev.vars to enable.
# LOG_RPC_PAYLOADS=1
